{
  "name": "portfolio-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:with-d1": "npx tsx scripts/fetch-d1-data.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "d1:create": "wrangler d1 create portfolio-db",
    "d1:migrate": "wrangler d1 execute portfolio-db --local --file=d1/schema.sql",
    "d1:seed": "wrangler d1 execute portfolio-db --local --file=d1/seed-data.sql && wrangler d1 execute portfolio-db --local --file=d1/translations.sql",
    "d1:push": "wrangler d1 execute portfolio-db --remote --file=d1/schema.sql && wrangler d1 execute portfolio-db --remote --file=d1/seed-data.sql && wrangler d1 execute portfolio-db --remote --file=d1/translations.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.2.0",
    "@cloudflare/workers-types": "^4.20260310.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "wrangler": "^4.72.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
