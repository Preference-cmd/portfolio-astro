# Cloudflare account credentials used by `pnpm build:with-kv`,
# `pnpm seed:kv`, and the deploy workflow. Copy this file to `.env`
# (gitignored) and fill in your own values.

# Cloudflare account ID (found in the Cloudflare dashboard URL or
# `wrangler whoami`).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with at least:
#   - Account.Workers Scripts:Edit
#   - Account.Workers KV Storage:Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare KV namespace ID (created via `wrangler kv namespace create
# PORTFOLIO_KV` or in the dashboard). The deploy workflow injects this
# into wrangler.toml at build time.
CLOUDFLARE_KV_NAMESPACE_ID=